<%- include('partials/header') %>
  <body
    class="min-h-screen flex items-center justify-center text-gray-800 font-sans login"
  >
    <div class="glass rounded-2xl shadow-2xl p-10 w-full max-w-md text-white">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold drop-shadow-lg">
          Welcome to <span class="text-yellow-400 drop-shadow-lg">FCM</span>
        </h2>
        <p class="text-sm text-gray-200 mt-2">Please login to your account</p>
      </div>

      <!-- مكان عرض رسالة الخطأ -->
      <div
        id="errorMessage"
        class="hidden mb-6 px-4 py-3 rounded-2xl relative glass border-red-400 border text-red-700 shadow-md flex items-center space-x-3"
        role="alert"
      >
        <!-- أيقونة خطأ (يمكنك تعديل أو حذف حسب رغبتك) -->
        <svg
          class="w-6 h-6 flex-shrink-0 text-red-600"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12" y2="16"></line>
        </svg>

        <!-- نص الخطأ -->
        <span id="errorText" class="font-semibold text-red-700 drop-shadow-md">
          Invalid email or password.
        </span>
      </div>

      <form id="loginForm" class="space-y-6" novalidate>
        <div>
          <label for="email" class="block mb-2 text-sm font-semibold text-white"
            >Email Address</label
          >
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@company.com"
            class="w-full px-4 py-3 rounded-md border border-gray-300 bg-white bg-opacity-90 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <div>
          <label
            for="password"
            class="block mb-2 text-sm font-semibold text-white"
            >Password</label
          >
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            class="w-full px-4 py-3 rounded-md border border-gray-300 bg-white bg-opacity-90 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <div class="flex justify-between items-center text-sm">
          <a href="#" class="text-yellow-300 hover:underline"
            >Forgot password?</a
          >
        </div>

        <button
          type="submit"
          class="w-full py-3 rounded-md bg-yellow-500 hover:bg-yellow-600 transition font-semibold shadow-md"
        >
          Sign In
        </button>
      </form>

      <p class="mt-6 text-center text-xs text-white">
        © 2025 FCM. All rights reserved.
      </p>
    </div>
    <script src="/js/api.js"></script>
    <script src="/js/login.js"></script>
  </body>
</html>
