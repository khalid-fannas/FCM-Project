<%- include('partials/header') %>
  <body
    class="min-h-screen flex items-center justify-center text-gray-800 font-sans login"
  >
    <div class="glass rounded-2xl shadow-2xl p-10 w-full max-w-md text-white">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold drop-shadow-lg">
          Set Your
          <span class="text-yellow-400 drop-shadow-lg">New Password</span>
        </h2>
        <p class="text-sm text-gray-200 mt-2">
          Please create your new password
        </p>
      </div>

      <!-- مكان عرض رسالة الخطأ أو النجاح -->
      <div
        id="messageBox"
        class="hidden mb-6 px-4 py-3 rounded-2xl relative glass border shadow-md flex items-center space-x-3"
        role="alert"
      >
        <svg
          id="messageIcon"
          class="w-6 h-6 flex-shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <!-- default icon (error) -->
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12" y2="16"></line>
        </svg>

        <span id="messageText" class="font-semibold drop-shadow-md">
          <!-- رسالة تظهر هنا -->
        </span>
      </div>

      <form id="newPasswordForm" class="space-y-6" novalidate>
        <div>
          <label
            for="password"
            class="block mb-2 text-sm font-semibold text-white"
            >New Password</label
          >
          <input
            type="password"
            id="password"
            name="password"
            required
            placeholder="••••••••"
            minlength="8"
            class="w-full px-4 py-3 rounded-md border border-gray-300 bg-white bg-opacity-90 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <div>
          <label
            for="confirmPassword"
            class="block mb-2 text-sm font-semibold text-white"
            >Confirm New Password</label
          >
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            placeholder="••••••••"
            minlength="8"
            class="w-full px-4 py-3 rounded-md border border-gray-300 bg-white bg-opacity-90 text-gray-900 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <button
          type="submit"
          class="w-full py-3 rounded-md bg-yellow-500 hover:bg-yellow-600 transition font-semibold shadow-md"
        >
          Save New Password
        </button>
      </form>
    </div>
    <script src="/js/api.js"></script>
    <script src="/js/setPassword.js"></script>
  </body>
</html>
