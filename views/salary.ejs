<%- include('partials/header') %>
<body class="bg-gradient-to-br from-indigo-50 to-purple-100 dark:from-gray-900 dark:to-black text-gray-900 dark:text-gray-100 transition-colors duration-500"x-data="LightingMode()" x-init="init()" x-cloak>

    <div class="w-full flex ">
        <div class="w-64"> <%- include('partials/sidebar') %></div>

        <main class="flex-1 p-6 h-screen overflow-y-auto max-w-full mx-auto bg-gray-50 dark:bg-gray-900 hide-scrollbar">
            <div class="flex w-[92%] justify-between items-center mb-6">
                <h1 class="text-2xl font-extrabold text-gray-600 dark:text-gray-100 tracking-tight">Salary</h1>
                <button id="addSalaryBtn" class="addBtn">
                    <i class="fas fa-plus mr-2"></i> Add Salary
                </button>
            </div>
            <div>
                <div id="salary-container" class="flex flex-col gap-4 text-gray-600 dark:text-gray-700">Loading...</div>
            </div>
        </main>
        <div class="absolute top-0 right-5 z-5000">  <%- include('partials/navigation') %>
    </div>
    <!-- Edit Salary Modal -->
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
      <form id="editForm"
        class="bg-white dark:bg-gray-900 p-8 rounded-2xl shadow-2xl max-w-lg w-full text-gray-700 dark:text-gray-100 space-y-6 border border-gray-200 dark:border-gray-700">
        
        <h3 class="text-xl font-bold text-start text-gray-800 dark:text-white">Edit Salary Details</h3>
    
        <input type="hidden" name="salaryId" id="salaryId" />
        <input type="hidden" name="employeeId" id="employeeId" />
    
        <div>
          <label for="employeeName" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Employee Name</label>
          <input type="text" id="employeeName" name="employeeName" disabled
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 cursor-not-allowed rounded-lg focus:outline-none transition" />
        </div>
    
        <div>
          <label for="baseSalary" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Base Salary</label>
          <input type="number" id="baseSalary" name="baseSalary" step="1"
            class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-700 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition" />
        </div>
    
        <div class="flex justify-center gap-3 pt-2">
          <button type="button" id="cancelEditBtn" class="cancelBtn flex items-center gap-2">
            <i class="fas fa-times"></i> Cancel
          </button>
          <button type="submit" class="submitBtn flex items-center gap-2">
            <i class="fas fa-save"></i> Save Change
          </button>
        </div>
      </form>
    </div>
    
      
    <!-- Add Salary Modal -->
    <div id="addSalaryModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
      <form id="addSalaryForm"
        class="bg-white dark:bg-gray-900 p-8 rounded-2xl shadow-2xl max-w-lg w-full text-gray-700 dark:text-gray-100 space-y-6 border border-gray-200 dark:border-gray-700">
        
        <h2 class="text-xl font-bold text-start text-gray-800 dark:text-white">Add Employee Salary</h2>
    
        <div>
          <label for="newEmployeeId" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Employee</label>
          <select id="newEmployeeId" required
            class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition">
            <option value="">Select employee</option>
            <!-- options loaded dynamically -->
          </select>
        </div>
    
        <div>
          <label for="newBaseSalary" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Base Salary ($)</label>
          <input type="number" id="newBaseSalary" required min="0" step="1"
            class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition" />
        </div>
        <div class="flex justify-center gap-3 pt-2">
          <button type="button" id="cancelAddSalaryBtn" class="cancelBtn flex items-center gap-2">
            <i class="fas fa-times"></i> Cancel
          </button>
          <button type="submit" class="submitBtn flex items-center gap-2">
            <i class="fas fa-plus"></i> Add
          </button>
        </div>
      </form>
    </div>
    
    <div id="deleteSalaryModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-full max-w-md p-6 text-center">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Are you sure you want to delete this salary record?</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">This action cannot be undone.</p>
        
            <div id="deleteSalaryMessage" class="mb-4 text-sm text-red-600 dark:text-red-400"></div>
        
            <div class="flex justify-center space-x-4">
            <button id="cancelDeleteSalary" class="cancelBtn" type="button">
                Cancel
            </button>
            <button id="confirmDeleteSalary" class="deleteBtn" type="button">
                Delete
            </button>
        </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/salary.js"></script>
</body>
</html>