<%- include('../partials/header') %>
<div class="relative">
  <div class="absolute top-4 right-10 z-50">
    <div
      class="flex items-center justify-center w-12 h-12 rounded-full shadow-md bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 transition-colors duration-300"
    >
      <button
        @click="toggleTheme()"
        aria-label="Toggle Dark Mode"
        class="w-full h-full flex items-center justify-center rounded-full focus:outline-none transition-colors duration-300 hover:bg-gray-100 dark:hover:bg-gray-700"
      >
        <template x-if="isDark">
          <i
            class="fas fa-moon text-xl text-yellow-400 transition-all duration-300"
          ></i>
        </template>
        <template x-if="!isDark">
          <i
            class="fas fa-sun text-xl text-yellow-500 transition-all duration-300"
          ></i>
        </template>
      </button>
    </div>
  </div>
</div>

<script>
  function LightingMode() {
    return {
      isDark: false,
      openMenu: null,

      init() {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme) {
          this.isDark = savedTheme === "dark";
        } else {
          this.isDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
        }
        this.updateBodyClass();
      },

      toggleTheme() {
        this.isDark = !this.isDark;
        localStorage.setItem("theme", this.isDark ? "dark" : "light");
        this.updateBodyClass();
      },

      updateBodyClass() {
        if (this.isDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      },

      toggleMenu(menuName) {
        this.openMenu = this.openMenu === menuName ? null : menuName;
      },

      closeAll() {
        this.openMenu = null;
      },
    };
  }
</script>
<script>
  tailwind.config = {
    darkMode: "class",
  };
</script>
