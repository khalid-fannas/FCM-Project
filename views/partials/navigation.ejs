<div class="relative" x-data="LightingMode()" x-init="init()">
  <div class="absolute top-5 right-6 z-50">
    <button
      @click="toggleTheme()"
      aria-label="Toggle Dark Mode"
      class="flex items-center justify-center w-12 h-12 rounded-full border-2 border-yellow-500 text-yellow-700 bg-gray-50 shadow-[0_0_6px_1px_rgba(202,138,4,0.3)] hover:bg-gray-100 hover:text-yellow-800 hover:shadow-[0_0_12px_3px_rgba(202,138,4,0.4)] transition duration-300 ease-in-out dark:bg-gray-900 dark:border-yellow-400 dark:text-yellow-400 dark:bg-opacity-100 dark:hover:shadow-[0_0_12px_4px_rgba(202,138,4,0.6)] dark:hover:bg-gray-900 dark:hover:text-yellow-300"
    >
      <template x-if="isDark">
        <i
          class="fas fa-moon text-xl text-yellow-400 transition-all duration-300"
        ></i>
      </template>
      <template x-if="!isDark">
        <i
          class="fas fa-sun text-xl text-yellow-600 transition-all duration-300"
        ></i>
      </template>
    </button>
  </div>
</div>

<script>
  function LightingMode() {
    return {
      isDark: false,
      init() {
        const savedTheme = localStorage.getItem("theme");
        if (savedTheme) {
          this.isDark = savedTheme === "dark";
        } else {
          this.isDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
        }
        this.updateBodyClass();
      },
      toggleTheme() {
        this.isDark = !this.isDark;
        localStorage.setItem("theme", this.isDark ? "dark" : "light");
        this.updateBodyClass();
      },
      updateBodyClass() {
        if (this.isDark) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      },
    };
  }
</script>

<script>
  tailwind.config = {
    darkMode: "class",
  };
</script>
