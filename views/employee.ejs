<%- include('partials/header') %>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100" x-data="LightingMode()" x-init="init()" x-cloak>
  <div class="flex min-h-screen">
    <div class="w-64">
      <%- include('partials/sidebar') %>
    </div>

    <main class="flex-1 p-6 h-screen overflow-y-auto w-full mx-auto hide-scrollbar">
      <div class="flex w-[92%] justify-between items-center mb-6">
        <h1 class="text-2xl font-extrabold text-gray-600 dark:text-gray-100 tracking-tight">
          Employees
        </h1>
        <button
          id="addEmployeeBtn"
          class="addBtn addEmployeeBtn">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none"
              viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          Add Employee
        </button>
      </div>
      <div id="employee-container" class="flex flex-col gap-6">
      </div>
    </main>
  </div>


  <div id="employeeModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white dark:bg-gray-900 rounded-lg shadow-2xl w-full max-w-5xl p-8 mx-4 sm:mx-0">
      <div id="modalMessage" class="mb-6 text-sm text-red-600 dark:text-red-400"></div>
      <h2 id="titleEmployeeModal" class="text-xl font-bold text-start text-gray-800 dark:text-white pb-4">Employee Modal</h2>

      <form id="employeeForm" class="flex flex-col items-center w-full">
        <div class="grid grid-cols-3 gap-6 w-full">
          <div>
            <label for="first_name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">First Name</label>
            <input type="text" name="first_name" id="first_name" placeholder="First Name"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="last_name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Last Name</label>
            <input type="text" name="last_name" id="last_name" placeholder="Last Name"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Email</label>
            <input type="email" name="email" id="email" placeholder="Email"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="phone_number" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Phone Number</label>
            <input type="number" name="phone_number" id="phone_number" placeholder="Phone Number"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="address" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Address</label>
            <input type="text" name="address" id="address" placeholder="Address"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="department_name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Department</label>
            <input type="text" name="department_name" id="department_name" placeholder="Department Name"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="position_name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Position</label>
            <input type="text" name="position_name" id="position_name" placeholder="Position Name"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>

          <div>
            <label for="shift_id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Shift ID</label>
            <select id="shift_id" name="shift_id" class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500">
            </select>
          </div>

          <div>
            <label for="hire_date" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Hire Date</label>
            <input type="date" name="hire_date" id="hire_date" placeholder="Hire Date"
              class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500"
              required />
          </div>
        </div>
  
        <div class="sm:col-span-2 flex justify-end gap-4 pt-4">
          <button type="button" id="cancelModal" class="cancelBtn flex items-center">
            <i class="fas fa-times mr-2 pointer-events-none"></i>
            Cancel
          </button>
          <button type="submit" id="submitBtn" class="submitBtn flex items-center">
            <i class="fas fa-floppy-disk mr-2"></i>
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>

  
  <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-full max-w-md p-6 text-center">
      <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">
        Are you sure you want to delete this employee?
      </h2>
      <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">
        This action cannot be undone.
      </p>
  
      <div id="deleteMessage" class="mb-4 text-sm"></div>
      <div class="flex justify-center space-x-4">
        <button id="cancelDelete" class="cancelBtn flex items-center px-4 py-2">
          <i class="fas fa-times mr-2 pointer-events-none"></i>
          Cancel
        </button>
        <button id="confirmDelete" class="deleteBtn flex items-center px-4 py-2">
          <i class="fas fa-trash-alt mr-2 pointer-events-none"></i>
          Delete
        </button>
      </div>
      
    </div>
  </div>
  

    <div class="absolute top-0 right-5 z-50">
      <%- include('partials/navigation') %>
    </div>
    <script src="/js/api.js"></script>
  <script src="/js/employee.js" defer></script>
</body>
</html>