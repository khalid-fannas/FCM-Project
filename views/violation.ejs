<%- include('partials/header') %>
<body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100" x-data="LightingMode()" x-init="init()" x-cloak>
    <div class="flex min-h-screen">
        <div class="w-64">
        <%- include('partials/sidebar') %>
        </div>

        <main class="flex-1 p-6 h-screen overflow-y-auto w-full flex flex-col gap-10 mx-auto hide-scrollbar">
            <div class="w-full flex flex-col">
                <div class="flex w-[92%] justify-between items-center mb-6">
                    <h1 class="text-2xl font-extrabold text-gray-600 dark:text-gray-100 tracking-tight">
                        List of violations
                    </h1>
                    <button
                    onclick="openAddModal()"
                        type="button"
                        class="addBtn flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-md focus:outline-none focus:ring-2 focus:ring-blue-400"
                        aria-label="Add new violation"
                                >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                        <span>Add Violation</span>
                    </button>
                </div>
                <% if (!violations || violations.length === 0) { %>
                    <div id="noViolationsMessage" class="w-full flex items-center gap-3 p-4 rounded-lg bg-gray-800 text-yellow-400 shadow-md">
                        <i class="fas fa-exclamation-triangle text-yellow-500 text-xl flex-shrink-0"></i>
                        <p class="text-sm md:text-base font-medium">There are currently no violations.</p>
                    </div>
                <% } else { %>
                    <section id="listOfViolations" class="w-full overflow-x-auto">
                        <div class="min-w-full rounded-t-lg shadow-lg overflow-hidden">
                            <div class="overflow-y-auto custom-scrollbar">
                                <table class="min-w-full text-sm text-left text-gray-800 dark:text-gray-300 border border-gray-300 dark:border-gray-700 hover:shadow-lg transition-shadow">
                                    <thead class="bg-gray-300 dark:bg-gray-700 text-xs uppercase text-gray-600 dark:text-gray-300 sticky top-0 z-10">
                                        <tr>
                                            <th class="px-4 py-3">NUM</th>
                                            <th class="px-4 py-3">Title</th>
                                            <th class="px-4 py-3">Description</th>
                                            <th class="px-4 py-3">Type</th>
                                            <th class="px-4 py-3">Weight</th>
                                            <th class="px-4 py-3 text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="violationsTableBody">
                                        <% violations.forEach(v => { %>
                                        <tr 
                                            class="violation-row border-b border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200"
                                            data-id="<%= v.id %>"
                                            data-title="<%= v.title %>"
                                            data-description="<%= v.description %>"
                                            data-type="<%= v.type %>"
                                            data-weight="<%= v.weight %>"
                                        >
                                            <td class="px-6 py-4"><%= v.id %></td>
                                            <td class="px-6 py-4"><%= v.title %></td>
                                            <td class="px-6 py-4 max-w-xl"><%= v.description %></td>
                                            <td class="px-6 py-4">
                                                <span class="bg-red-100 text-red-800 dark:bg-red-700 dark:text-white px-3 py-1 rounded-full text-xs font-semibold shadow">
                                                    <%= v.type.replace('_', ' ') %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4"><%= v.weight || '-' %></td>
                                            <td class="px-6 py-4 flex gap-3 justify-center items-center">
                                                <button 
                                                    onclick="openEditModal(this)" 
                                                    class="editBtn px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-medium">
                                                    Edit
                                                </button>
                                                <button 
                                                    onclick="openDeleteModal(this)" 
                                                    class="deleteBtn px-3 py-1 bg-red-600 hover:bg-red-700 text-white rounded text-xs font-medium">
                                                    Delete
                                                </button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                    
                                </table>
                            </div>
                        </div>
                    </section>
                <% } %>
                
            </div>
            <div class="w-full flex flex-col">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 sticky top-0 z-10 gap-4">
    
                    <h1 class="text-2xl font-extrabold text-gray-600 dark:text-gray-100 tracking-tight">
                        Violations Records
                    </h1>
                    <div class="w-full md:w-auto">
                        <input 
                            type="text" 
                            id="searchInput" 
                            placeholder="Search by name or email..." 
                            class="w-full md:w-72 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 dark:bg-gray-900 dark:text-gray-100"
                        >
                    </div>
                    <div class="w-full md:w-auto flex justify-end">
                        <button onclick="showViolationsRecordModal()" class="addBtn flex items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            Add Employee Violation
                        </button>
                    </div>
                </div>
                
            
                <div id="Violations-container" class="flex flex-col gap-6 rounded-lg pr-1 overflow-y-auto custom-scrollbar">
                    <p id="noResultsMessage" class="hidden text-center text-gray-500 dark:text-gray-400 mt-4">
                        No results found.
                    </p>
                    <% records.forEach(record => { %>
                        <div 
                        data-id="<%= record.id %>" 
                        data-name="<%= record.employee_name.toLowerCase() %>" 
                        data-email="<%= record.email.toLowerCase() %>"
                        class="violation-card bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 rounded-lg shadow-md flex flex-col justify-between border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow">
                            <div class="w-full flex items-center justify-between">
                                <div class="w-full flex flex-col">
                                <div class="w-full flex justify-between items-center p-4 border-b border-gray-300">
                                    <h2 class="text-base font-extrabold text-gray-500 dark:text-gray-300">
                                    <%= record.employee_name %>
                                    </h2>
                                    <div class="flex items-center gap-4">
                                        <button type="button" class="editBtn" onclick="openEditViolationRecordModal(this)">
                                            <i class="fas fa-edit mr-2 pointer-events-none"></i>Edit
                                        </button>
                                        <button 
                                            type="button"
                                            class="deleteViolationEmployeeBtn deleteBtn"
                                            onclick="openDeleteRecordModal('<%= record.id %>')"
                                            >
                                            <i class="fas fa-trash-alt mr-2 pointer-events-none"></i>Delete
                                        </button>
                                    </div>
                                </div>
                        
                                <div class="p-4 w-full grid grid-cols-3 gap-4">
                                    <div>
                                    <p><span>Email:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.email %></span></p>
                                    <p><span>Phone:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.phone || 'N/A' %></span></p>
                                    <p><span>Department:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.department || 'N/A' %></span></p>
                                    </div>
                                    <div>
                                    <p><span>Violation Title:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.violation_title %></span></p>
                                    <p><span>Type:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.violation_type || 'N/A' %></span></p>
                                    <p><span>Weight:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.violation_weight || 'N/A' %></span></p>
                                    </div>
                                    <div>
                                    <p><span>Reason:</span> <span id="violationRecordReason" class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.reason%></span></p>
                                    <p><span>Reason Type:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.reason_type %></span></p>
                                    <p><span>Reported By:</span> <span class="italic text-gray-400 font-semibold dark:text-gray-500"><%= record.reported_by || 'N/A' %></span></p>
                                    </div>
                                </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </main>
    </div>

    <div id="ViolationModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-2xl w-full max-w-2xl p-8 mx-4 sm:mx-0">
            <div id="modalMessage" class="mb-6 text-sm text-red-600 dark:text-red-400"></div>
            <h2 class="text-xl font-bold text-start text-gray-800 dark:text-white pb-4">Add Violation</h2>
            <input type="hidden" id="violationIdInput" />

            <form id="violationForm" class="flex flex-col gap-4">
                <div>
                    <label for="violation_type" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Violation Type</label>
                    <select name="violation_type" id="violation_type" class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required>
                        <option value="">Select Type</option>
                        <option value="verbal_warning">Verbal Warning</option>
                        <option value="first_warning">First Warning</option>
                        <option value="final_warning">Final Warning</option>
                        <option value="termination">Termination</option>
                    </select>
                </div>
                <div>
                    <label for="violation_title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Violation Title</label>
                    <input type="text" name="violation_title" id="violation_title" placeholder="Enter title" class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required />
                </div>
                <div>
                    <label for="violation_description" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Violation Description</label>
                    <textarea name="violation_description" id="violation_description" rows="4" placeholder="Describe the violation..." class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required></textarea>
                </div>
                <div class="sm:col-span-2 flex justify-center gap-4 pt-4">
                    <button type="button" onclick="closeModal()" class="cancelBtn flex items-center">
                        <i class="fas fa-times mr-2 pointer-events-none"></i> Cancel
                    </button>
                    <button id="saveViolationBtn" type="submit" class="submitBtn flex items-center">
                        <i class="fas fa-paper-plane mr-2 pointer-events-none"></i> Submit
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="editViolationRecordModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-2xl w-full max-w-xl p-8 mx-4 sm:mx-0">
            
            <div class="mb-6">
                <h2 class="text-xl font-bold text-start text-gray-800 dark:text-white">
                    Edit Violation for 
                    <span class="text-sky-600 dark:text-sky-400">Abedalhakim Abu-Alasal</span>
                </h2>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                    Email: <span class="font-medium text-gray-800 dark:text-gray-300">abedalhakim@gmail.com</span>
                </p>
            </div>
    
            <form id="editViolationForm" class="flex flex-col gap-4">
                <div>
                    <label for="violation_title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Violation</label>
                    <select name="violation_title" id="violation_title" class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required></select>
                </div>
            
                <div>
                    <label for="reason" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Reason</label>
                    <textarea name="reason" id="reason" rows="3" class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-2 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required></textarea>
                </div>
            
                <div class="flex justify-center gap-4 pt-4">
                    <button type="button" id="cancelEditModal" class="cancelBtn flex items-center">
                        <i class="fas fa-times mr-2 pointer-events-none"></i> Cancel
                    </button>
                    <button id="saveEditModal" type="submit" class="submitBtn flex items-center">
                        <i class="fas fa-save mr-2 pointer-events-none"></i> Save Changes
                    </button>
                </div>
            </form>
            
        </div>
    </div>

    <div id="ViolationsRecordModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-900 rounded-lg shadow-2xl w-full max-w-xl p-8 mx-4 sm:mx-0">
            
            <div class="mb-6">
                <h2 class="text-xl font-bold text-start text-gray-800 dark:text-white">
                    Add Violation for Employee 
                </h2>
            </div>
    
            <form id="editViolationRecordForm" class="flex flex-col gap-4">
                <div>
                    <label for="employees" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Select Employee</label>
                    <select name="employee" id="employee" class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required>
                        
                    </select>
                </div>
                <div>
                    <label for="violation_title" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Violation</label>
                    <select name="violation_title" id="violation_title" class="w-full rounded-md border border-gray-300 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500" required>
                    </select>
                </div>
                <div>
                    <label for="reason" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Reason</label>
                    <input type="text" name="reason" id="addReason" placeholder="Enter The Reason For The Violations....." class="w-full rounded-md border border-gray-300 bg-white px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-100 dark:placeholder-gray-500" required />
                </div>
                
                <div class="flex justify-center gap-4 pt-4">
                    <button type="button" id="cancelAddModal" class="cancelBtn flex items-center">
                        <i class="fas fa-times mr-2 pointer-events-none"></i> Cancel
                    </button>
                    <button type="submit" class="submitBtn flex items-center">
                        <i class="fas fa-save mr-2 pointer-events-none"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="deleteViolationModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-full max-w-md p-6 text-center">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Are you sure you want to delete this violation?</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">This action cannot be undone.</p>

            <div id="deleteMessage" class="mb-4 text-sm"></div>
            <div class="flex justify-center space-x-4">
            <button  onclick="closeDeleteModal()" class="cancelBtn flex items-center">
                <i class="fas fa-times mr-2 pointer-events-none"></i> Cancel
            </button>
            <button onclick="confirmDelete()" class="deleteBtn flex items-center">
                <i class="fas fa-trash-alt mr-2 pointer-events-none"></i> Delete
            </button>
            </div>
        </div>
    </div>

    <div id="deleteViolationRecordModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-full max-w-md p-6 text-center">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Are you sure you want to delete this violation Record?</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">This action cannot be undone.</p>

            <div id="deleteMessage" class="mb-4 text-sm"></div>
            <div class="flex justify-center space-x-4">
                <button  onclick="closeDeleteRecordModal()" class="cancelBtn flex items-center">
                    <i class="fas fa-times mr-2 pointer-events-none"></i> Cancel
                </button>
                <button onclick="confirmRecordDelete()" class="deleteBtn flex items-center">
                    <i class="fas fa-trash-alt mr-2 pointer-events-none"></i> Delete
                </button>
            </div>
        </div>
    </div>

    <div class="absolute top-0 right-5 z-50">
        <%- include('partials/navigation') %>
    </div>
    <script src="/js/api.js"></script>
    <script src="/js/violations.js"></script>
    <script src="/js/violationsRecord.js"></script>
</body>
</html>