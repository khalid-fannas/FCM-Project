<%- include('partials/header') %>
 
<body x-data="LightingMode()" x-init="init()" x-cloak class="bg-gray-100 text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    

    
   <div class="flex min-h-screen">
    <div class="w-64 bg-gray-200 dark:bg-gray-800">
      <%- include('partials/sidebar') %>
    </div>

    <div class="flex-1 p-6 h-screen overflow-y-auto w-full mx-auto hide-scrollbar">
        <div class="flex w-[92%] justify-between items-center mb-6">
            <h1 class="text-3xl font-bold">Users</h1>
            <button
                onclick="openUserForm()"
                class="addBtn">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Add User
            </button>
        </div>
        <div id="userCardContainer" class="w-full flex flex-col gap-6 items-center justify-between ">
        </div>
    
        <div id="notification" class="hidden p-4 mb-4 rounded text-white"></div>
    </div>

    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <form onsubmit="handleEditSubmit(event)"
            class="bg-white dark:bg-gray-900 p-8 rounded-2xl shadow-2xl max-w-lg w-full text-gray-700 dark:text-gray-100 space-y-6 border border-gray-200 dark:border-gray-700">
            
            <h2 class="text-xl font-bold text-start text-gray-800 dark:text-white">Edit User</h2>
    
            <input type="hidden" id="editIndex" />
    
            <div>
                <label for="editEmail" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Work Email</label>
                <input id="editEmail" type="email" required
                    class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition" />
            </div>
    
            <div>
                <label for="editRole" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Role</label>
                <select id="editRole" required
                    class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition">
                    <option value="super_admin">Super Admin</option>
                    <option value="admin">Admin</option>
                    <option value="hr">HR</option>
                    <option value="data_entry">Data Entry</option>
                    <option value="employee">Employee</option>
                </select>
            </div>
    
            <div>
                <label for="editEmployee" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Employee</label>
                <input id="editEmployee" type="text" required readonly
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-700 bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 cursor-not-allowed rounded-lg focus:outline-none transition" />
                <p class="text-sm text-gray-500 mt-1 dark:text-gray-400">This employee is already linked to the user and cannot be changed.</p>
            </div>
    
            <div class="flex justify-center gap-3 pt-2">
                <button type="button" onclick="closeModal()"
                    class="cancelBtn">
                    Cancel
                </button>
                <button type="submit"
                    class="submitBtn">
                    Submit
                </button>
            </div>
        </form>
    </div>
    
    <!-- User Form Modal -->
    <div id="userFormModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <form id="userForm"
            class="bg-white dark:bg-gray-900 p-8 rounded-2xl shadow-2xl max-w-lg w-full text-gray-700 dark:text-gray-100 space-y-6 border border-gray-200 dark:border-gray-700">
            
            <h2 class="text-xl font-bold text-start text-gray-800 dark:text-white">Add User</h2>
    
            <div>
                <label for="employeeSelect" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Select Employee</label>
                <select id="employeeSelect" name="employeeId"
                    class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition">
                </select>
            </div>
    
            <div>
                <label for="workEmail" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Work Email</label>
                <input id="workEmail" type="email" placeholder="Work Email"
                    class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition"
                    required>
            </div>
    
            <div>
                <label for="roleSelect" class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Role</label>
                <select name="role" id="roleSelect"
                    class="w-full bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700 rounded-lg px-4 py-3 text-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:focus:ring-blue-400 transition"
                    required>
                    <option value="">Select Role</option>
                    <option value="super_admin">Super_Admin</option>
                    <option value="admin">Admin</option>
                    <option value="hr">HR</option>
                    <option value="data_entry">Data_Entry</option>
                    <option value="employee">Employee</option>
                </select>
            </div>
    
            <div class="flex justify-center gap-3 pt-2">
                <button type="button" onclick="closeUserForm()"
                    class="cancelBtn">
                    Cancel
                </button>
                <button type="submit"
                    class="addBtn">
                    Add User 
                </button>
            </div>
        </form>
    </div>
    
    <!-- Delete Modal -->
    <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg w-full max-w-md p-6 text-center">
            <h2 class="text-lg font-semibold text-gray-800 dark:text-white mb-4">Are you sure you want to delete user</h2>
            <p id="deleteIndex" class="font-semibold text-red-600 dark:text-red-400 mb-2"></p>
            <div class="flex justify-center gap-6">
                <button onclick="closeModal()" 
                        class="cancelBtn">
                    Cancel
                </button>
                <button id="confirmDeleteBtn" 
                        class="deleteBtn">
                    Delete
                </button>
            </div>
        </div>
    </div>
    <div class="absolute top-0 right-5 z-5000">  <%- include('partials/navigation') %>
    <script src="/js/api.js"></script>
    <script src="/js/users.js" defer></script>
</body>
</html>