<%- include('partials/header') %>
 
<body x-data="LightingMode()" x-init="init()" x-cloak class="bg-gray-100 text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    

    
   <div class="flex min-h-screen">
    <!-- Sidebar -->
    <div class="w-64 bg-gray-200 dark:bg-gray-800">
      <%- include('partials/sidebar') %>
    </div>

    <!-- Main Content -->
    <div class="flex-1 flex justify-center items-start py-10">
      <div class="w-full max-w-5xl">
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold">Users</h1>
          <button onclick="openUserForm()" class="bg-blue-500 text-white px-4 py-2 rounded">Add User</button>
        </div>

        <table class="w-full bg-white dark:bg-gray-800 shadow-md rounded overflow-hidden">
          <thead class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-100">
            <tr>
              <th class="py-3 px-4 text-left">#</th>
              <th class="py-3 px-4 text-left">Work Email</th>
              <th class="py-3 px-4 text-left">Role</th>
              <th class="py-3 px-4 text-left">Employee</th>
              <th class="py-3 px-4 text-left">Actions</th>
            </tr>
          </thead>
          <tbody id="userTableBody" class="text-gray-700 dark:text-gray-100">
            <!-- Data rows will be injected here -->
          </tbody>
        </table>
        <div id="notification" class="hidden p-4 mb-4 rounded text-white"></div>
      </div>
    </div>
  </div>

    <!-- Edit Modal -->
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center hidden z-50 backdrop-blur-sm">
        <div class="bg-white dark:bg-gray-800 p-8 rounded shadow-xl max-w-md w-full text-gray-600 dark:text-gray-100">
            <h2 class="text-2xl font-extrabold mb-6 tracking-wide">Edit User</h2>
            <form onsubmit="handleEditSubmit(event)" class="space-y-6">
                <input type="hidden" id="editIndex" />
                
                <div>
                    <label for="editEmail" class="block mb-2 font-semibold text-gray-700 dark:text-gray-300">Work Email</label>
                    <input id="editEmail" type="email" required
                        class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded focus:outline-none focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-600 dark:bg-gray-700 dark:text-gray-100 transition" />
                </div>
                
                <div>
                    <label for="editRole" class="block mb-2 font-semibold text-gray-700 dark:text-gray-300">Role</label>
                    <select id="editRole" required
                        class="w-full px-4 py-3 border border-gray-300 bg-white dark:bg-gray-700 dark:border-gray-600 text-gray-700 dark:text-gray-100 rounded focus:outline-none focus:ring-2 focus:ring-blue-400 dark:focus:ring-blue-600 transition">
                        <option value="super_admin">Super Admin</option>
                        <option value="admin">Admin</option>
                        <option value="hr">HR</option>
                        <option value="data_entry">Data Entry</option>
                        <option value="employee">Employee</option>
                    </select>
                </div>
                    
                <div>
                    <label for="editEmployee" class="block mb-2 font-semibold text-gray-700 dark:text-gray-300">Employee</label>
                    <input
                    id="editEmployee"
                    type="text"
                    required
                    readonly
                    class="w-full px-4 py-3 border border-gray-200 dark:border-gray-600 bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400 cursor-not-allowed rounded focus:outline-none transition"
                    />
                    <p class="text-sm text-gray-500 mt-1 dark:text-gray-400">This employee is already linked to the user and cannot be changed.</p>
                </div>
                
                <div class="flex justify-end space-x-4">
                    <button type="button" onclick="closeModal()"
                        class="px-5 py-2 rounded bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 transition duration-300">
                        Cancel
                    </button>
                    <button type="submit"
                        class="px-5 py-2 rounded bg-blue-600 hover:bg-blue-700 text-white font-semibold transition duration-300 shadow-md shadow-blue-400/50">
                        Save
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- User Form Modal -->
    <div id="userFormModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center hidden z-50 backdrop-blur-sm">
        <form id="userForm" class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-2xl max-w-xl w-full text-gray-700 dark:text-gray-100 space-y-4">
            <h2 class="text-2xl font-bold mb-6 text-center text-gray-800 dark:text-white">Add System User</h2>
        
            <div>
                <label for="employeeSelect" class="block mb-1 font-medium text-gray-700 dark:text-gray-300">Select Employee</label>
                <select id="employeeSelect" name="employeeId" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100" required></select>
            </div>
        
            <div>
                <label for="workEmail" class="block mb-1 font-medium text-gray-700 dark:text-gray-300">Work Email</label>
                <input id="workEmail" type="email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100" required placeholder="Work Email">
            </div>
        
            <div>
                <label for="roleSelect" class="block mb-1 font-medium text-gray-700 dark:text-gray-300">Role</label>
                <select name="role" id="roleSelect" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100" required>
                    <option value="">Select Role</option>
                    <option value="super_admin">Super_Admin</option>
                    <option value="admin">Admin</option>
                    <option value="hr">HR</option>
                    <option value="data_entry">Data_Entry</option>
                    <option value="employee">Employee</option>
                </select>
            </div>
        
            <div class="flex justify-end gap-3 pt-4">
                <button type="button" onclick="closeUserForm()" class="px-5 py-2 bg-gray-400 hover:bg-gray-500 text-white rounded-lg transition-all duration-200">Cancel</button>
                <button type="submit" class="px-5 py-2 bg-green-600 hover:bg-green-700 text-white font-medium rounded-lg transition-all duration-200">Create</button>
            </div>
        </form>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center hidden z-50 backdrop-blur-sm">
        <div class="bg-white dark:bg-gray-800 p-8 rounded shadow-xl max-w-sm w-full text-center text-gray-600 dark:text-gray-100">
            <h2 class="text-2xl font-extrabold mb-6 tracking-wide">Delete User</h2>
            <p class="mb-8 text-gray-700 dark:text-gray-300">
                Are you sure you want to delete user <span id="deleteIndex" class="font-semibold text-red-600 dark:text-red-400"></span>?
            </p>
            <div class="flex justify-center gap-6">
                <button onclick="closeModal()" 
                        class="px-5 py-2 rounded bg-gray-200 hover:bg-gray-300 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 transition duration-300">
                    Cancel
                </button>
                <button id="confirmDeleteBtn" 
                        class="px-5 py-2 rounded bg-red-600 hover:bg-red-700 text-white font-semibold transition duration-300 shadow-md shadow-red-400/50">
                    Delete
                </button>
            </div>
        </div>
    </div>
    <div class="absolute top-0 right-5 z-5000">  <%- include('partials/navigation') %>
    <script src="/js/api.js"></script>
    <script src="/js/users.js" defer></script>
</body>
</html>
